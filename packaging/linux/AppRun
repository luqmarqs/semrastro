#!/bin/sh
# Ponto de entrada do AppImage. Resolve tudo a partir da propria pasta montada.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="$HERE"
# Sem ICU (InvariantGlobalization no csproj) e sem dependencia da pasta atual.
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
exec "$HERE/usr/lib/semrastro/SemRastro" "$@"
